# bws-broker: holds the Bitwarden Secrets Manager access token and runs a
# value-redacting subset of bws for the devcontainer, and proxies the Proxmox
# API with a token it reads from Bitwarden. Built and run by
# compose.yaml as the bws-broker service.
FROM docker.io/library/debian:trixie-slim

ARG BWS_VERSION=2.1.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 ca-certificates openssl curl unzip \
    && arch="$(uname -m)" \
    && case "$arch" in x86_64|aarch64) ;; *) echo "Unsupported arch: $arch" >&2; exit 1 ;; esac \
    && zip="bws-${arch}-unknown-linux-gnu-${BWS_VERSION}.zip" \
    && base="https://github.com/bitwarden/sdk-sm/releases/download/bws-v${BWS_VERSION}" \
    && mkdir /tmp/bws && cd /tmp/bws \
    && curl -fsSLO "${base}/${zip}" \
    && curl -fsSL "${base}/bws-sha256-checksums-${BWS_VERSION}.txt" -o checksums.txt \
    && grep " ${zip}\$" checksums.txt | sha256sum -c - \
    && unzip -q "$zip" \
    && install -m 755 bws /usr/local/bin/bws \
    && cd / && rm -rf /tmp/bws \
    && apt-get purge -y curl unzip \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --system --uid 10001 --no-create-home --home-dir /tmp broker

# --chmod: COPY keeps the host file mode, and the broker user must be able to read it
COPY --chmod=755 server.py /usr/local/bin/bws-broker

USER broker
# bws keeps state under $HOME; /tmp is a tmpfs when run with --read-only
ENV HOME=/tmp
# 8080: /bws (HTTP). 8006: Proxmox API proxy (TLS, cert made at startup by openssl)
EXPOSE 8080 8006
ENTRYPOINT ["python3", "/usr/local/bin/bws-broker"]
